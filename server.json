{
    "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
    "name": "io.github.andreasjhagen/document-parser",
    "description": "MCP server that reads documents as Markdown and creates or edits DOCX files",
    "version": "1.1.1",
    "icons": [
        {
            "src": "https://unpkg.com/@cynosure-mcp/document-parser@1.1.1/icon.png",
            "mimeType": "image/png"
        }
    ],
    "packages": [
        {
            "registryType": "npm",
            "identifier": "@cynosure-mcp/document-parser",
            "version": "1.1.1",
            "transport": {
                "type": "stdio"
            },
            "environmentVariables": []
        }
    ],
    "repository": {
        "url": "https://github.com/Cynosure-MCP-Collection/mcp-document-parser",
        "source": "github"
    }
}
