{
  "name": "@cynosure-mcp/document-parser",
  "mcpName": "io.github.andreasjhagen/document-parser",
  "version": "1.1.2",
  "description": "MCP server that reads documents as Markdown and creates or edits DOCX files",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "document-parser": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "release:check": "node scripts/sync-version.mjs --check",
    "version": "node scripts/sync-version.mjs && git add server.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "docx": "^9.5.1",
    "officeparser": "^6.0.7",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist",
    "server.json",
    "icon.png"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "document",
    "parser",
    "docx",
    "writer",
    "pdf",
    "pptx",
    "xlsx",
    "office"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cynosure-MCP-Collection/mcp-document-parser.git"
  },
  "homepage": "https://github.com/Cynosure-MCP-Collection/mcp-document-parser#readme",
  "bugs": {
    "url": "https://github.com/Cynosure-MCP-Collection/mcp-document-parser/issues"
  }
}
