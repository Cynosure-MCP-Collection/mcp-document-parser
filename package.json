{
  "name": "@cynosure-mcp/document-parser",
  "mcpName": "io.github.andreasjhagen/document-parser",
  "version": "1.0.1",
  "description": "MCP server that extracts text from documents (.docx, .pptx, .xlsx, .odt, .odp, .ods, .pdf, .rtf) and returns it as Markdown",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "document-parser": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "officeparser": "^6.0.7",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist",
    "server.json",
    "icon.png"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "document",
    "parser",
    "docx",
    "pdf",
    "pptx",
    "xlsx",
    "office"
  ]
}
